ions":[],"news":[]},"articles":[{"slug":"stuttgart-eintracht-francfort-undav-atubolu-deux-voisins-au-classement","title":"Stuttgart - Eintracht Francfort : Undav, Atubolu, deux voisins au classement… les clés de l'affiche de la 11e journée de Bundesliga","hook":"Huitième de Bundesliga, le VfB Stuttgart reçoit samedi (18h30) l'Eintracht Francfort, septième avec deux points d'avance. Un duel direct pour les places européennes, entre une équipe éprouvée par la Ligue des champions et des Hessois revenus en forme.","date":"2026-11-28T09:20:04.948Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/stuttgart-eintracht-francfort-undav-atubolu-deux-voisins-au--4bbed7462b.jpg","thumb":"https://actusport24h.fr/img/thumbs/stuttgart-eintracht-francfort-undav-atubolu-deux-voisins-au--4bbed7462b.webp","imageAlt":"Un duel entre l'Eintracht Francfort et le VfB Stuttgart en Bundesliga","credit":"© IMAGO / Sportfoto Rudel","read":3,"tags":["Bundesliga","VfB Stuttgart","Eintracht Francfort","Sebastian Hoeneß","Adi Hütter","Deniz Undav","Noah Atubolu","Can Uzun"],"url":"https://actusport24h.fr/article/stuttgart-eintracht-francfort-undav-atubolu-deux-voisins-au-classement/"}],"fil":[{"id":"art-bundesliga-sept-penalties-arretes-sur-onze-noah-atubolu-signe-un-recor","date":"2026-11-23T19:28:00.000Z","label":"info","title":"Bundesliga : sept penalties arrêtés sur onze, Noah Atubolu signe un record historique avec l'Eintracht Francfort","text":"En stoppant la tentative d'Andrej Kramarić samedi contre Hoffenheim, le gardien allemand a atteint un ratio inédit en Bundesliga.","body":"Noah Atubolu confirme sa réputation de spécialiste des penalties. Samedi, lors de la victoire de l'Eintracht Francfort contre Hoffenheim (1-0), le gardien de 24 ans a repoussé la tentative d'Andrej Kramarić, qui avait réussi ses 18 derniers penalties en championnat. Arrivé de Fribourg l'été dernier, Atubolu a désormais arrêté sept des onze penalties tirés contre lui en Bundesliga, dont sept des huit derniers depuis mai 2024. Aucun gardien n'avait affiché un tel ratio sur un tel volume de tirs en près de 64 ans de Bundesliga.","competition":"Bundesliga","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/bundesliga-sept-penalties-arretes-sur-onze-noah-atubolu-signe-un-recor/","url":"https://actusport24h.fr/fil-info/bundesliga-sept-penalties-arretes-sur-onze-noah-atubolu-signe-un-recor/"}],"matchIds":["401915515","401915511","401884734","401884725","401884715","401884742","401884748","401884760","401884768","401884779","401915526","401915543"]}