"SUB","posFr":null,"min":"76"}],"bench":[{"id":"290691","n":"19","name":"Ivan Turitsov","short":"Turitsov","pos":"SUB","posFr":null},{"id":"410123","n":"7","name":"Kristiyan Balov","short":"Balov","pos":"SUB","posFr":null},{"id":"257928","n":"10","name":"Asen Chandarov","short":"Chandarov","pos":"SUB","posFr":null},{"id":"364237","n":"3","name":"Emil Tsenov","short":"Tsenov","pos":"SUB","posFr":null},{"id":"243848","n":"1","name":"Daniel Naumov","short":"Naumov","pos":"SUB","posFr":null},{"id":"342925","n":"5","name":"Ivano Pankov","short":"Pankov","pos":"SUB","posFr":null},{"id":"323269","n":"12","name":"Aleks Bozhev","short":"Bozhev","pos":"SUB","posFr":null}]},"probableLineup":null,"absences":{"source":"espn","injuries":[],"suspensions":[],"news":[]},"articles":[],"fil":[{"id":"art-ligue-des-nations-l-estonie-bat-la-bulgarie-2-1-pour-finir-sa-campagne","date":"2026-11-16T22:06:09.011Z","label":"info","title":"Ligue des nations : l'Estonie bat la Bulgarie (2-1) pour finir sa campagne","text":"Patrik Kristal et Kevor Palumets ont offert la victoire aux Estoniens à Tallinn.","body":"L'Estonie a terminé sa Ligue des nations sur un succès face à la Bulgarie (2-1), lundi à la A. Le Coq Arena de Tallinn. Patrik Kristal a ouvert le score dès la 8e minute, son premier but en sélection. Svetoslav Kovachev a égalisé pour les Bulgares dans le temps additionnel de la première période, avant que Kevor Palumets ne donne la victoire aux Estoniens de la tête à l'heure de jeu. Dans le même groupe de Ligue C, l'Islande a battu le Luxembourg (3-0).","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-l-estonie-bat-la-bulgarie-2-1-pour-finir-sa-campagne/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-l-estonie-bat-la-bulgarie-2-1-pour-finir-sa-campagne/"},{"id":"art-ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai","date":"2026-11-16T18:56:12.167Z","label":"info","title":"Ligue des nations : l'Islande corrige le Luxembourg (3-0) et termine invaincue en tête de son groupe","text":"À Reykjavik, Brynjólfur Willumsson, Andri Gudjohnsen sur penalty et Mikael Ellertsson ont offert aux Islandais un quatrième succès dans le groupe 4 de la Ligue C. L'Estonie a battu la Bulgarie (2-1).","body":"L'**Islande** a conclu sa phase de groupes en patron. Au Laugardalsvöllur de **Reykjavik**, les Islandais ont dominé le **Luxembourg** (**3-0**) lors de la dernière journée du groupe 4 de la **Ligue C**.\n\n**Brynjólfur Willumsson** a ouvert le score de la tête (25e), avant qu'**Andri Gudjohnsen** ne transforme un penalty (37e). **Mikael Ellertsson** a scellé le succès peu après la pause (50e).\n\nAvec **14 points** (4 victoires, 2 nuls), l'Islande termine première et invaincue. Dans l'autre match du groupe, l'**Estonie** s'est imposée face à la **Bulgarie** (**2-1**) à Tallinn grâce à **Patrik Kristal** (8e) et **Kevor Palumets** (60e, de la tête), malgré l'égalisation de **Svetoslav Kovachev** juste avant la pause (45e+1) et l'expulsion de Karel Mustmaa dans le temps additionnel. Les Estoniens, eux aussi sans défaite, finissent deuxièmes avec 12 points, devant la Bulgarie (4) et le Luxembourg (3).","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai/"}],"matchIds":["401861157","401861183","401861061","401861083","401861112","401861141"]}