rt":"Pereira","pos":null,"posFr":null},{"id":"221927","n":"21","name":"Sebastien Thill","short":"Thill","pos":null,"posFr":null},{"id":"236764","n":"14","name":"Eric Veiga","short":"Veiga","pos":null,"posFr":null},{"id":"179306","n":"22","name":"Tim Hall","short":"Hall","pos":null,"posFr":null},{"id":"258672","n":"15","name":"Farid Ikene","short":"Ikene","pos":null,"posFr":null}]},"probableLineup":null,"absences":{"source":"espn","injuries":[],"suspensions":[],"news":[]},"articles":[],"fil":[{"id":"art-ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai","date":"2026-11-16T18:56:12.167Z","label":"info","title":"Ligue des nations : l'Islande corrige le Luxembourg (3-0) et termine invaincue en tête de son groupe","text":"À Reykjavik, Brynjólfur Willumsson, Andri Gudjohnsen sur penalty et Mikael Ellertsson ont offert aux Islandais un quatrième succès dans le groupe 4 de la Ligue C. L'Estonie a battu la Bulgarie (2-1).","body":"L'**Islande** a conclu sa phase de groupes en patron. Au Laugardalsvöllur de **Reykjavik**, les Islandais ont dominé le **Luxembourg** (**3-0**) lors de la dernière journée du groupe 4 de la **Ligue C**.\n\n**Brynjólfur Willumsson** a ouvert le score de la tête (25e), avant qu'**Andri Gudjohnsen** ne transforme un penalty (37e). **Mikael Ellertsson** a scellé le succès peu après la pause (50e).\n\nAvec **14 points** (4 victoires, 2 nuls), l'Islande termine première et invaincue. Dans l'autre match du groupe, l'**Estonie** s'est imposée face à la **Bulgarie** (**2-1**) à Tallinn grâce à **Patrik Kristal** (8e) et **Kevor Palumets** (60e, de la tête), malgré l'égalisation de **Svetoslav Kovachev** juste avant la pause (45e+1) et l'expulsion de Karel Mustmaa dans le temps additionnel. Les Estoniens, eux aussi sans défaite, finissent deuxièmes avec 12 points, devant la Bulgarie (4) et le Luxembourg (3).","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai/"}],"matchIds":["401861154","401861182","401861061","401861086","401861115","401861141"]}