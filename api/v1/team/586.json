uspensions":[],"news":[]},"articles":[{"slug":"ligue-des-nations-turquie-et-tchequie-releguees-l-irlande-du-nord-prom","title":"Ligue des nations : Turquie et Tchéquie reléguées, l'Irlande du Nord promue, la Ligue D disparaît… tous les verdicts de la phase de ligue","hook":"La phase de ligue de la Ligue des nations 2026-2027 a rendu ses derniers verdicts mardi soir. Entre les huit quarts de finalistes, les promus, les relégués et les barragistes, voici ce qu'il faut retenir avant le tirage de vendredi.","date":"2026-11-18T11:40:45.670Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/ligue-des-nations-turquie-et-tchequie-releguees-l-irlande-du-32190187bb.jpg","thumb":"https://actusport24h.fr/img/thumbs/ligue-des-nations-turquie-et-tchequie-releguees-l-irlande-du-32190187bb.webp","imageAlt":"Les joueurs du Portugal, dont João Cancelo, célèbrent un but au pays de Galles à Cardiff en Ligue des nations","credit":"© AP Photo","read":2,"tags":["Ligue des nations","Turquie","Tchéquie","Irlande du Nord","Suisse","Portugal","Norvège","Euro 2028"],"url":"https://actusport24h.fr/article/ligue-des-nations-turquie-et-tchequie-releguees-l-irlande-du-nord-prom/"}],"fil":[{"id":"art-ligue-des-nations-turquie-et-tchequie-releguees-l-irlande-du-nord-prom","date":"2026-11-18T11:40:45.670Z","label":"analyse","title":"Ligue des nations : Turquie et Tchéquie reléguées, l'Irlande du Nord promue, la Ligue D disparaît… tous les verdicts de la phase de ligue","text":"La phase de ligue de la Ligue des nations 2026-2027 a rendu ses derniers verdicts mardi soir. Entre les huit quarts de finalistes, les promus, les relégués et les barragistes, voici ce qu'il faut retenir avant le tirage de vendredi.","body":null,"competition":"Ligue des nations","articleSlug":"ligue-des-nations-turquie-et-tchequie-releguees-l-irlande-du-nord-prom","pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-turquie-et-tchequie-releguees-l-irlande-du-nord-prom/","url":"https://actusport24h.fr/article/ligue-des-nations-turquie-et-tchequie-releguees-l-irlande-du-nord-prom/"},{"id":"art-ligue-des-nations-invaincue-l-irlande-du-nord-monte-en-ligue-a-pour-la","date":"2026-11-18T10:49:00.000Z","label":"info","title":"Ligue des nations : invaincue, l'Irlande du Nord monte en Ligue A pour la première fois","text":"Le nul arraché en Hongrie mardi a offert aux hommes de Michael O'Neill la première place du groupe B2.","body":"L'**Irlande du Nord** évoluera en Ligue A de la Ligue des nations pour la première fois. Mardi à Budapest, l'égalisation de **Justin Devenny** face à la **Hongrie** lui a apporté le point nécessaire pour terminer en tête du groupe B2, au bout d'une campagne sans défaite : trois victoires, trois nuls et un seul but encaissé. Il y a deux ans, la sélection de Michael O'Neill évoluait encore en Ligue C. Elle connaîtra ses adversaires des qualifications à l'Euro 2028 lors du tirage de décembre.","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-invaincue-l-irlande-du-nord-monte-en-ligue-a-pour-la/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-invaincue-l-irlande-du-nord-monte-en-ligue-a-pour-la/"},{"id":"art-ligue-des-nations-l-irlande-du-nord-monte-en-ligue-a-la-georgie-et-la","date":"2026-11-17T21:53:00.000Z","label":"info","title":"Ligue des nations : l'Irlande du Nord monte en Ligue A, la Géorgie et la Roumanie reléguées en Ligue C","text":"La dernière journée de la Ligue B a rendu ses verdicts mardi soir, avec une promotion pour les Nord-Irlandais.","body":"Grâce à un nul en Hongrie (1-1), l'Irlande du Nord termine en tête de son groupe de Ligue B et accède à la Ligue A. Deuxième, la Hongrie passera par les barrages. Battue par l'Ukraine (0-1), la Géorgie descend en Ligue C, tout comme la Roumanie, battue par la Bosnie-Herzégovine (2-1), qui disputera les barrages. L'Autriche, déjà promue, a fait match nul face à Israël (1-1), relégué. L'Irlande a écrasé le Kosovo (3-0) et disputera les barrages, tandis que la Suède, assurée de la première place, a été tenue en échec en Pologne (1-1).","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-l-irlande-du-nord-monte-en-ligue-a-la-georgie-et-la/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-l-irlande-du-nord-monte-en-ligue-a-la-georgie-et-la/"},{"id":"art-ligue-des-nations-l-autriche-et-la-suede-valident-leur-montee-en-ligue","date":"2026-11-14T22:10:27.596Z","label":"info","title":"Ligue des nations : l'Autriche et la Suède valident leur montée en Ligue A","text":"En Ligue B, l'Autriche a battu l'Irlande grâce à un but de Sasa Kalajdzic (78e) et la Suède a dominé la Bosnie-Herzégovine (3-2) : les deux sélections rejoindront l'élite de la Ligue des nations. L'Irlande du Nord a, elle, surpris l'Ukraine (1-0, Devlin 68e).","body":null,"competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-l-autriche-et-la-suede-valident-leur-montee-en-ligue/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-l-autriche-et-la-suede-valident-leur-montee-en-ligue/"}],"matchIds":["401861169","401861191","401861049","401861079","401861106","401861132"]}