id":"239724","n":"8","name":"Alexandru Cicaldau","short":"Cicaldau","pos":"SUB","posFr":null,"min":"45"},{"id":"306354","n":"19","name":"Marius Dumitru Corbu","short":"Corbu","pos":"SUB","posFr":null,"min":"64"},{"id":"362062","n":"23","name":"Tony Strata","short":"Strata","pos":"SUB","posFr":null,"min":"64"},{"id":"239734","n":"7","name":"Florinel Coman","short":"Coman","pos":"SUB","posFr":null,"min":"64"},{"id":"307171","n":"17","name":"Catalin Cirjan","short":"Cirjan","pos":"SUB","posFr":null,"min":"75"}],"bench":[{"id":"248669","n":"21","name":"Olimpiu Morutan","short":"Morutan","pos":"SUB","posFr":null},{"id":"239895","n":"16","name":"Laurentiu Popescu","short":"Popescu","pos":"SUB","posFr":null},{"id":"406479","n":"15","name":"Lisav Eissat","short":"Eissat","pos":"SUB","posFr":null},{"id":"259802","n":"5","name":"Virgil Ghita","short":"Ghita","pos":"SUB","posFr":null},{"id":"268690","n":"1","name":"Stefan Tarnovanu","short":"Tarnovanu","pos":"SUB","posFr":null},{"id":"322795","n":"14","name":"Rares Ilie","short":"Ilie","pos":"SUB","posFr":null},{"id":"307848","n":"13","name":"Matei Ilie","short":"Ilie","pos":"SUB","posFr":null}]},"probableLineup":null,"absences":{"source":"espn","injuries":[],"suspensions":[],"news":[]},"articles":[],"fil":[{"id":"art-ligue-des-nations-la-bosnie-herzegovine-renverse-la-roumanie-de-gheorg","date":"2026-11-17T23:49:47.198Z","label":"info","title":"Ligue des nations : la Bosnie-Herzégovine renverse la Roumanie de Gheorghe Hagi (2-1) malgré une bourde de son gardien","text":"Menés après une erreur de Martin Zlomislić, les Bosniens ont fini le groupe 4 de la Ligue B à la deuxième place.","body":"La **Bosnie-Herzégovine** a battu la **Roumanie** (2-1), mardi à Zenica, en **Ligue des nations**. Les Roumains ont ouvert le score dès la 6e minute par **Daniel Bîrligea**, servi par **Dennis Man**, sur une frappe mal négociée par le gardien **Martin Zlomislić**. **Benjamin Tahirović** a égalisé juste avant la pause (44e), puis **Esmir Bajraktarević** a donné la victoire aux siens d'une frappe en lucarne (82e). La Bosnie termine deuxième du groupe avec 11 points, derrière la Suède, tandis que la sélection de **Gheorghe Hagi** finit dernière avec 3 points.","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-la-bosnie-herzegovine-renverse-la-roumanie-de-gheorg/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-la-bosnie-herzegovine-renverse-la-roumanie-de-gheorg/"},{"id":"art-ligue-des-nations-l-irlande-du-nord-monte-en-ligue-a-la-georgie-et-la","date":"2026-11-17T21:53:00.000Z","label":"info","title":"Ligue des nations : l'Irlande du Nord monte en Ligue A, la Géorgie et la Roumanie reléguées en Ligue C","text":"La dernière journée de la Ligue B a rendu ses verdicts mardi soir, avec une promotion pour les Nord-Irlandais.","body":"Grâce à un nul en Hongrie (1-1), l'Irlande du Nord termine en tête de son groupe de Ligue B et accède à la Ligue A. Deuxième, la Hongrie passera par les barrages. Battue par l'Ukraine (0-1), la Géorgie descend en Ligue C, tout comme la Roumanie, battue par la Bosnie-Herzégovine (2-1), qui disputera les barrages. L'Autriche, déjà promue, a fait match nul face à Israël (1-1), relégué. L'Irlande a écrasé le Kosovo (3-0) et disputera les barrages, tandis que la Suède, assurée de la première place, a été tenue en échec en Pologne (1-1).","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-l-irlande-du-nord-monte-en-ligue-a-la-georgie-et-la/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-l-irlande-du-nord-monte-en-ligue-a-la-georgie-et-la/"}],"matchIds":["401861168","401861196","401861051","401861078","401861108","401861128"]}