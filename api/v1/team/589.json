osFr":null,"min":"57"},{"id":"341762","n":"7","name":"Fabio Notaro","short":"Notaro","pos":"SUB","posFr":null,"min":"88"},{"id":"326682","n":"17","name":"Liam Kranz","short":"Kranz","pos":"SUB","posFr":null,"min":"88"}],"bench":[{"id":"310420","n":"15","name":"Andrin Netzer","short":"Netzer","pos":"SUB","posFr":null},{"id":"5333266","n":"4","name":"Philipp Alexander Ospelt","short":"Ospelt","pos":"SUB","posFr":null},{"id":"310421","n":"21","name":"Gabriel Foser","short":"Foser","pos":"SUB","posFr":null},{"id":"258495","n":"12","name":"Justin Ospelt","short":"Ospelt","pos":"SUB","posFr":null},{"id":"154156","n":"13","name":"Luca Beck","short":"Beck","pos":"SUB","posFr":null},{"id":"5332572","n":"18","name":"Manuel Mikus","short":"Mikus","pos":"SUB","posFr":null},{"id":"275608","n":"9","name":"Ferhat Saglam","short":"Saglam","pos":"SUB","posFr":null}]},"probableLineup":null,"absences":{"source":"espn","injuries":[],"suspensions":[],"news":[]},"articles":[],"fil":[{"id":"art-ligue-des-nations-la-lituanie-bat-le-liechtenstein-2-1-et-finit-deuxie","date":"2026-11-16T18:56:12.168Z","label":"info","title":"Ligue des nations : la Lituanie bat le Liechtenstein (2-1) et finit deuxième de son groupe","text":"À Kaunas, Eligijus Jankauskas et Manfredas Ruzgis, sur penalty, ont donné la victoire aux Lituaniens, malgré un coup franc direct d'Aron Sele.","body":"La **Lituanie** a terminé sa campagne sur une victoire. À **Kaunas**, les Lituaniens ont battu le **Liechtenstein** (**2-1**) lors de la dernière journée du groupe 2 de la **Ligue D**.\n\n**Eligijus Jankauskas** a ouvert le score dès la 16e minute, avant que **Manfredas Ruzgis** ne double la mise sur penalty juste après la pause (50e). Le Liechtenstein a réduit l'écart dix minutes plus tard grâce à un coup franc direct d'**Aron Sele** (60e), mais n'a pas réussi à revenir.\n\nAvec ce succès, la Lituanie termine avec **7 points**, deuxième du groupe à une longueur de l'**Azerbaïdjan** (8 points), qui avait déjà achevé son parcours. Le Liechtenstein finit dernier avec un seul point en quatre rencontres.","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-la-lituanie-bat-le-liechtenstein-2-1-et-finit-deuxie/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-la-lituanie-bat-le-liechtenstein-2-1-et-finit-deuxie/"}],"matchIds":["401861153","401861184","401861043","401861093"]}