":"2","name":"Alex Cornellà","short":"Cornellà","pos":"SUB","posFr":null},{"id":"310610","n":"4","name":"Christian Garcia","short":"Garcia","pos":"SUB","posFr":null},{"id":"326549","n":"3","name":"Eric Vales","short":"Vales","pos":"SUB","posFr":null}]},"probableLineup":null,"absences":{"source":"espn","injuries":[],"suspensions":[],"news":[{"date":"2026-11-14T19:24:53.112Z","title":"Mort de Jesús de Miguel : le gardien d'Andorre Jesús Owono suspendu 12 matchs, la sanction maximale","url":"/article/mort-de-jesus-de-miguel-le-gardien-d-andorre-jesus-owono-suspendu-12-m/","slug":"mort-de-jesus-de-miguel-le-gardien-d-andorre-jesus-owono-suspendu-12-m"}]},"articles":[{"slug":"mort-de-jesus-de-miguel-le-gardien-d-andorre-jesus-owono-suspendu-12-m","title":"Mort de Jesús de Miguel : le gardien d'Andorre Jesús Owono suspendu 12 matchs, la sanction maximale","hook":"La Fédération espagnole a infligé douze matchs de suspension à Jesús Owono, le gardien du FC Andorra dont la charge a coûté la vie à l'attaquant de Tenerife Jesús de Miguel. Le score de 2-2 est homologué et la rencontre ne sera pas rejouée.","date":"2026-11-14T19:24:53.112Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"officiel","labelName":"Officiel","image":"https://actusport24h.fr/img/posts/owono.jpg","thumb":"https://actusport24h.fr/img/thumbs/owono.webp","imageAlt":"Jesús Owono, gardien du FC Andorra, sous le maillot noir d'Andorre","credit":"© Sky Sports","read":2,"tags":["Jesús Owono","Jesús de Miguel","FC Andorre","Tenerife","RFEF","Liga 2"],"url":"https://actusport24h.fr/article/mort-de-jesus-de-miguel-le-gardien-d-andorre-jesus-owono-suspendu-12-m/"}],"fil":[{"id":"art-carles-puyol-fait-son-retour-dans-le-football-comme-dirigeant-de-l-int","date":"2026-11-19T19:53:24.408Z","label":"info","title":"Carles Puyol fait son retour dans le football comme dirigeant de l'Inter Club d'Escaldes, champion d'Andorre","text":"L'ancien capitaine du FC Barcelone, 48 ans, devient directeur des relations et du football international du club andorran.","body":"**Carles Puyol** retrouve le football. L'**Inter Club d'Escaldes**, champion d'Andorre en titre, a annoncé sur ses réseaux sociaux la nomination de l'ancien capitaine du **FC Barcelone** au poste de directeur des relations et du football international. Installé en Andorre depuis 2022, le champion du monde 2010 rejoint un club qui dispute cette saison la phase de ligue de la Ligue Conférence, une première pour une équipe du pays.","competition":"Andorre","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/carles-puyol-fait-son-retour-dans-le-football-comme-dirigeant-de-l-int/","url":"https://actusport24h.fr/fil-info/carles-puyol-fait-son-retour-dans-le-football-comme-dirigeant-de-l-int/"},{"id":"art-espagne-l-entraineur-de-tenerife-alvaro-cervera-repond-a-gerard-pique","date":"2026-11-17T15:18:00.000Z","label":"info","title":"Espagne : l'entraîneur de Tenerife Álvaro Cervera répond à Gerard Piqué sur la sanction de Jesús Owono","text":"Le coach de Tenerife estime que le propriétaire d'Andorre devrait revoir l'action qui a coûté la vie à Jesús de Miguel.","body":"Interrogé avant le match de Coupe du Roi contre Badajoz, Álvaro Cervera a réagi aux propos de Gerard Piqué, actionnaire majoritaire du FC Andorra, qui avait jugé injuste la suspension de 12 matchs infligée au gardien Jesús Owono. L'entraîneur de Tenerife a reconnu que Piqué était dans son rôle en défendant son club et ses joueurs, mais lui a conseillé de revoir l'action, qui selon lui « aurait pu être évitée » et n'est pas une action « que l'on voit tous les jours ». Le choc avait entraîné la mort de l'attaquant de Tenerife Jesús de Miguel.","competition":"Liga 2","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/espagne-l-entraineur-de-tenerife-alvaro-cervera-repond-a-gerard-pique/","url":"https://actusport24h.fr/fil-info/espagne-l-entraineur-de-tenerife-alvaro-cervera-repond-a-gerard-pique/"},{"id":"art-mort-de-jesus-de-miguel-gerard-pique-juge-pas-juste-la-suspension-de-1","date":"2026-11-17T05:00:00.000Z","label":"info","title":"Mort de Jesús de Miguel : Gerard Piqué juge « pas juste » la suspension de 12 matchs de Jesús Owono","text":"Le patron du FC Andorre est sorti du silence pour défendre son gardien, sanctionné par la Fédération espagnole.","body":"**Gerard Piqué** a réagi pour la première fois à l'affaire qui secoue la D2 espagnole. Dans une vidéo publiée lundi soir sur TikTok, l'actionnaire majoritaire du **FC Andorre** estime que la suspension de 12 matchs infligée à son gardien **Jesús Owono** le place dans « une situation qui n'est pas juste ». Le 2 novembre, Owono avait violemment percuté l'attaquant de Tenerife **Jesús de Miguel**, décédé le lendemain. Pour l'ancien défenseur du Barça, la sanction devrait viser l'action et non ses conséquences.","competition":"Liga 2","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/mort-de-jesus-de-miguel-gerard-pique-juge-pas-juste-la-suspension-de-1/","url":"https://actusport24h.fr/fil-info/mort-de-jesus-de-miguel-gerard-pique-juge-pas-juste-la-suspension-de-1/"},{"id":"art-mort-de-jesus-de-miguel-le-gardien-d-andorre-jesus-owono-suspendu-12-m","date":"2026-11-14T19:24:53.112Z","label":"officiel","title":"Mort de Jesús de Miguel : le gardien d'Andorre Jesús Owono suspendu 12 matchs, la sanction maximale","text":"La Fédération espagnole a infligé douze matchs de suspension à Jesús Owono, le gardien du FC Andorra dont la charge a coûté la vie à l'attaquant de Tenerife Jesús de Miguel. Le score de 2-2 est homologué et la rencontre ne sera pas rejouée.","body":null,"competition":"Europe","articleSlug":"mort-de-jesus-de-miguel-le-gardien-d-andorre-jesus-owono-suspendu-12-m","pageUrl":"https://actusport24h.fr/fil-info/mort-de-jesus-de-miguel-le-gardien-d-andorre-jesus-owono-suspendu-12-m/","url":"https://actusport24h.fr/article/mort-de-jesus-de-miguel-le-gardien-d-andorre-jesus-owono-suspendu-12-m/"},{"id":"art-portugal-cristiano-ronaldo-junior-fait-ses-debuts-avec-les-u17-lors-du","date":"2026-11-13T10:22:12.987Z","label":"officiel","title":"Portugal : Cristiano Ronaldo Junior fait ses débuts avec les U17 lors du succès 4-0 contre Andorre","text":"Le fils de Cristiano Ronaldo, joueur d'Al-Nassr, est entré en fin de match pour sa première apparition avec les moins de 17 ans portugais, devant plusieurs anciens coéquipiers de son père.","body":null,"competition":"Europe","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/portugal-cristiano-ronaldo-junior-fait-ses-debuts-avec-les-u17-lors-du/","url":"https://actusport24h.fr/fil-info/portugal-cristiano-ronaldo-junior-fait-ses-debuts-avec-les-u17-lors-du/"}],"matchIds":["401861155","401861047","401861069","401861120"]}