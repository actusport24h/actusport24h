6","name":"Hjörtur Hermannsson","short":"Hermannsson","pos":"CD-R","posFr":"Défenseur central droit"},{"id":"153510","n":"4","name":"Victor Palsson","short":"Palsson","pos":"RB","posFr":"Latéral droit"}],[{"id":"311527","n":"12","name":"Hákon Valdimarsson","short":"Valdimarsson","pos":"G","posFr":"Gardien"}]],"subsIn":[{"id":"121910","n":"10","name":"Gylfi Sigurdsson","short":"Sigurdsson","pos":"SUB","posFr":null,"min":"45"},{"id":"311168","n":"20","name":"Kristian Hlynsson","short":"Hlynsson","pos":"SUB","posFr":null,"min":"45"},{"id":"95094","n":"14","name":"Aron Gunnarsson","short":"Gunnarsson","pos":"SUB","posFr":null,"min":"64"},{"id":"261506","n":"11","name":"Jon Dagur Thorsteinsson","short":"Thorsteinsson","pos":"SUB","posFr":null,"min":"64"},{"id":"295807","n":"5","name":"Isak Thorvaldsson","short":"Thorvaldsson","pos":"SUB","posFr":null,"min":"78"}],"bench":[{"id":"319426","n":"15","name":"Brynjar Bjarnason","short":"Bjarnason","pos":"SUB","posFr":null},{"id":"199330","n":"1","name":"Rúnar Rúnarsson","short":"Rúnarsson","pos":"SUB","posFr":null},{"id":"255228","n":"21","name":"Arnór Sigurdsson","short":"Sigurdsson","pos":"SUB","posFr":null},{"id":"250697","n":"18","name":"Mikkel Anderson","short":"Anderson","pos":"SUB","posFr":null},{"id":"275227","n":"6","name":"Thorir Johann Helgason","short":"Helgason","pos":"SUB","posFr":null},{"id":"237860","n":"13","name":"Anton Ari Einarsson","short":"Einarsson","pos":"SUB","posFr":null},{"id":"326637","n":"23","name":"Saevar Atli Magnússon","short":"Magnússon","pos":"SUB","posFr":null}]},"probableLineup":null,"absences":{"source":"espn","injuries":[],"suspensions":[],"news":[]},"articles":[],"fil":[{"id":"art-ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai","date":"2026-11-16T18:56:12.167Z","label":"info","title":"Ligue des nations : l'Islande corrige le Luxembourg (3-0) et termine invaincue en tête de son groupe","text":"À Reykjavik, Brynjólfur Willumsson, Andri Gudjohnsen sur penalty et Mikael Ellertsson ont offert aux Islandais un quatrième succès dans le groupe 4 de la Ligue C. L'Estonie a battu la Bulgarie (2-1).","body":"L'**Islande** a conclu sa phase de groupes en patron. Au Laugardalsvöllur de **Reykjavik**, les Islandais ont dominé le **Luxembourg** (**3-0**) lors de la dernière journée du groupe 4 de la **Ligue C**.\n\n**Brynjólfur Willumsson** a ouvert le score de la tête (25e), avant qu'**Andri Gudjohnsen** ne transforme un penalty (37e). **Mikael Ellertsson** a scellé le succès peu après la pause (50e).\n\nAvec **14 points** (4 victoires, 2 nuls), l'Islande termine première et invaincue. Dans l'autre match du groupe, l'**Estonie** s'est imposée face à la **Bulgarie** (**2-1**) à Tallinn grâce à **Patrik Kristal** (8e) et **Kevor Palumets** (60e, de la tête), malgré l'égalisation de **Svetoslav Kovachev** juste avant la pause (45e+1) et l'expulsion de Karel Mustmaa dans le temps additionnel. Les Estoniens, eux aussi sans défaite, finissent deuxièmes avec 12 points, devant la Bulgarie (4) et le Luxembourg (3).","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai/"}],"matchIds":["401861157","401861182","401861058","401861086","401861112","401861136"]}