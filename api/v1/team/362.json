t":"Torres","pos":"CD-L","posFr":"Défenseur central gauche","starts":5,"changed":false},{"id":"204679","n":"3","name":"Victor Lindelöf","short":"Lindelöf","pos":"CD-R","posFr":"Défenseur central droit","starts":5,"changed":false},{"id":"281121","n":"4","name":"Taylor Harwood-Bellis","short":"Harwood-Bellis","pos":"RB","posFr":"Latéral droit","starts":1,"changed":false}],[{"id":"265958","n":"1","name":"Zion Suzuki","short":"Suzuki","pos":"G","posFr":"Gardien","starts":5,"changed":false}]],"changes":[],"bench":[{"id":"301524","n":"35","name":"João Gomes","short":"Gomes","pos":"SUB","posFr":null},{"id":"214375","n":"10","name":"Emiliano Buendía","short":"Buendía","pos":"SUB","posFr":null},{"id":"388522","n":"19","name":"Ibrahim Mbaye","short":"Mbaye","pos":"SUB","posFr":null},{"id":"152469","n":"6","name":"Ross Barkley","short":"Barkley","pos":"SUB","posFr":null},{"id":"234698","n":"2","name":"Matty Cash","short":"Cash","pos":"RB","posFr":"Latéral droit"},{"id":"181312","n":"5","name":"Tyrone Mings","short":"Mings","pos":"SUB","posFr":null},{"id":"366248","n":"53","name":"George Hemmings","short":"Hemmings","pos":"SUB","posFr":null},{"id":"132233","n":"40","name":"Marco Bizot","short":"Bizot","pos":"SUB","posFr":null},{"id":"325555","n":"17","name":"Alejandro Garnacho","short":"Garnacho","pos":"SUB","posFr":null}]},"absences":{"source":"espn","injuries":[],"suspensions":[],"news":[]},"articles":[{"slug":"premier-league-arsenal-a-27-points-brighton-dauphin-manchester-united","title":"Premier League : Arsenal à 27 points, Brighton dauphin, Manchester United 18e… le bilan après dix journées","hook":"Neuf victoires en dix matchs, sept clean sheets et cinq points d'avance : Arsenal aborde la reprise de samedi en patron. Derrière, Brighton bouscule la hiérarchie tandis que Manchester United, 18e, lance l'ère Pochettino à Anfield.","date":"2026-11-18T21:41:57.349Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/premier-league-arsenal-a-27-points-brighton-dauphin-manchest-e46fdae4be.jpg","thumb":"https://actusport24h.fr/img/thumbs/premier-league-arsenal-a-27-points-brighton-dauphin-manchest-e46fdae4be.webp","imageAlt":"Martin Ødegaard célèbre son but avec Arsenal à l'Emirates Stadium","credit":"© Arsenal FC","read":2,"tags":["Premier League","Arsenal","Brighton","Manchester City","Manchester United","Mauricio Pochettino","Martin Ødegaard","Liverpool"],"url":"https://actusport24h.fr/article/premier-league-arsenal-a-27-points-brighton-dauphin-manchester-united/"}],"fil":[{"id":"art-officiel-amadou-onana-prolonge-son-contrat-avec-aston-villa","date":"2026-11-19T00:33:17.972Z","label":"officiel","title":"Officiel : Amadou Onana prolonge son contrat avec Aston Villa","text":"Le club de Birmingham a annoncé la signature d'un nouveau contrat pour son milieu belge, toujours blessé au genou, sans en préciser la durée.","body":"Arrivé d'Everton à l'été 2024, **Amadou Onana** s'est gravement blessé au genou avec la Belgique pendant la Coupe du monde 2026. Le milieu de terrain est toujours en convalescence et n'est pas attendu avant mars au plus tôt. **Aston Villa** a malgré tout choisi de lui réaffirmer sa confiance, en le présentant comme un élément important de l'effectif d'**Unai Emery**.","competition":"Mercato","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/officiel-amadou-onana-prolonge-son-contrat-avec-aston-villa/","url":"https://actusport24h.fr/fil-info/officiel-amadou-onana-prolonge-son-contrat-avec-aston-villa/"},{"id":"art-officiel-aston-villa-prolonge-amadou-onana-toujours-en-convalescence-a","date":"2026-11-18T12:13:46.402Z","label":"officiel","title":"Officiel : Aston Villa prolonge Amadou Onana, toujours en convalescence après sa blessure au genou","text":"Le milieu belge, arrivé d'Everton en 2024, a signé un nouveau contrat avec les Villans.","body":"**Aston Villa** a annoncé ce mercredi la prolongation de contrat d'**Amadou Onana**. Le club anglais n'a pas précisé la durée du nouveau bail, mais selon The Athletic, l'international belge (25 ans) est désormais lié aux Villans jusqu'en 2031. Passé par le LOSC, recruté à Everton en 2024, Onana compte plus de 70 matchs et sept buts sous le maillot d'Aston Villa. Gravement touché au genou lors de la Coupe du monde l'été dernier avec la Belgique, il n'a pas encore joué cette saison et poursuit sa rééducation. Le club le présente comme un élément important de l'effectif d'Unai Emery.","competition":"Premier League","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/officiel-aston-villa-prolonge-amadou-onana-toujours-en-convalescence-a/","url":"https://actusport24h.fr/fil-info/officiel-aston-villa-prolonge-amadou-onana-toujours-en-convalescence-a/"},{"id":"art-barca-rodri-pourrait-faire-son-retour-le-2-decembre-face-a-l-atletico","date":"2026-11-16T14:29:16.684Z","label":"rumeur","title":"Barça : Rodri pourrait faire son retour le 2 décembre face à l'Atlético de Madrid, selon Sport","text":"Blessé contre Aston Villa début novembre, le milieu espagnol viserait le choc de Liga au Camp Nou.","body":"Absent depuis sa blessure contre Aston Villa au début du mois, **Rodri** manque au FC Barcelone comme à la sélection espagnole pendant cette trêve internationale. D'après le quotidien catalan Sport, son retour pourrait intervenir le 2 décembre, lors de la réception de l'**Atlético de Madrid** au Camp Nou.\n\nCe match de Liga a été avancé en raison de la Supercoupe d'Espagne et s'annonce important dans la course au titre entre les deux équipes. Si ce calendrier se confirme, le milieu aura été éloigné des terrains environ un mois. Le Barça devra donc encore se passer de lui lors des prochaines rencontres, à commencer par la réception de Villarreal.","competition":"Liga","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/barca-rodri-pourrait-faire-son-retour-le-2-decembre-face-a-l-atletico/","url":"https://actusport24h.fr/fil-info/barca-rodri-pourrait-faire-son-retour-le-2-decembre-face-a-l-atletico/"}],"matchIds":["401915300","401878756","401878752","401878751","401878776","401879240","401879250","401879256","401879258","401915387","401915394","401915409","401915426"]}