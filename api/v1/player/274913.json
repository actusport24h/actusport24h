al Əliyev en pointe.","competition":"Ligue des champions","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/sabah-fc-barcelone-frenkie-de-jong-en-defense-centrale-gavi-titulaire/","url":"https://actusport24h.fr/fil-info/sabah-fc-barcelone-frenkie-de-jong-en-defense-centrale-gavi-titulaire/"}]}