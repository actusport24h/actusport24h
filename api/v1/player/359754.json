eamlogos/soccer/500/349.png"},"my":"0","op":"3","started":true,"played":true,"in":null,"out":null,"pos":"Attaquant","g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401874978","date":"2026-10-18T16:00Z","comp":"ita.1","team":"103","home":true,"opp":{"id":"105","name":"Atalanta","short":"Atalanta","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/105.png"},"my":"3","op":"2","started":false,"played":false,"in":null,"out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[{"slug":"belgique-italie-4-1-les-diables-rouges-renversent-la-nazionale-et-file","title":"Belgique-Italie (4-1) : les Diables Rouges renversent la Nazionale et filent en quarts de la Ligue des nations, l'Italie éliminée","hook":"Menée après un but de Pio Esposito, la Belgique a inscrit trois buts en onze minutes avant d'enfoncer le clou par Diego Moreira. Les hommes de Mark van Bommel accompagnent la France en quarts de finale, tandis que l'Italie de Roberto Mancini, trois jours après avoir battu les Bleus, termine troisième.","date":"2026-11-15T21:50:23.123Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/belgique-italie-4-1-les-diables-rouges-renversent-la-naziona-dda06852a4.jpg","thumb":"https://actusport24h.fr/img/thumbs/belgique-italie-4-1-les-diables-rouges-renversent-la-naziona-dda06852a4.webp","imageAlt":"Les joueurs belges, dont Youri Tielemans et Charles De Ketelaere, se congratulent après la victoire 4-1 contre l'Italie","credit":"© Diables Rouges / URBSFA (@BelRedDevils sur X)","read":2,"tags":["Ligue des nations","Belgique","Italie","Jérémy Doku","Diego Moreira","Maxime De Cuyper","Nathan Ngoy","Pio Esposito","Gianluigi Donnarumma","Kevin De Bruyne","Mark van Bommel","Roberto Mancini","Axel Witsel"],"url":"https://actusport24h.fr/article/belgique-italie-4-1-les-diables-rouges-renversent-la-nazionale-et-file/"}],"fil":[{"id":"art-ligue-europa-mene-2-0-au-piree-l-ac-milan-renverse-l-olympiakos-2-4-av","date":"2026-11-26T19:45:56.783Z","label":"info","title":"Ligue Europa : mené 2-0 au Pirée, l'AC Milan renverse l'Olympiakos (2-4) avec un Omari Hutchinson décisif","text":"Menés après un but contre son camp de Mike Maignan, les Rossoneri ont inscrit quatre buts en seconde période.","body":"L'**AC Milan** a signé un renversement spectaculaire sur la pelouse de l'**Olympiakos** (2-4), jeudi, lors de la 5e journée de la **Ligue Europa**. Les Grecs menaient 2-0 après un but contre son camp de **Mike Maignan** (31e) et une frappe de Jota Silva, servi par Remo Freuler (49e). **Omari Hutchinson** a alors pris le match à son compte : buteur d'une frappe de loin en contre (56e), il a servi **Alphadjo Cissé** de la tête (63e) puis **Christian Pulisic** (71e). Dans le temps additionnel, Pulisic a lancé **Diego Moreira** pour le quatrième but (90e+5).","competition":"Ligue Europa","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-europa-mene-2-0-au-piree-l-ac-milan-renverse-l-olympiakos-2-4-av/","url":"https://actusport24h.fr/fil-info/ligue-europa-mene-2-0-au-piree-l-ac-milan-renverse-l-olympiakos-2-4-av/"}]}