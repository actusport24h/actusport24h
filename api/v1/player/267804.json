ion":null,"statsSeason":null,"matches":[],"inj":null,"articles":[{"slug":"real-madrid-celta-vigo-mourinho-vise-une-neuvieme-victoire-de-suite-tc","title":"Real Madrid - Celta Vigo : Mourinho vise une neuvième victoire de suite, Tchouaméni et Bernardo Silva de retour à l'entraînement","hook":"Deuxième de Liga à trois points du Barça, le Real Madrid reçoit le Celta samedi (21h) au Bernabéu pour la 13e journée. Bonne nouvelle pour José Mourinho : Aurélien Tchouaméni et Bernardo Silva ont retrouvé le groupe jeudi.","date":"2026-11-19T17:21:05.943Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/real-madrid-celta-vigo-mourinho-vise-une-neuvieme-victoire-d-e5d9fb0db1.jpg","thumb":"https://actusport24h.fr/img/thumbs/real-madrid-celta-vigo-mourinho-vise-une-neuvieme-victoire-d-e5d9fb0db1.webp","imageAlt":"Vinícius Jr et Aurélien Tchouaméni à l'entraînement du Real Madrid à Valdebebas, jeudi 19 novembre","credit":"© Real Madrid CF","read":3,"tags":["Liga","Real Madrid","Celta Vigo","José Mourinho","Aurélien Tchouaméni","Bernardo Silva","Kylian Mbappé","Vinícius Jr","Santiago Bernabéu"],"url":"https://actusport24h.fr/article/real-madrid-celta-vigo-mourinho-vise-une-neuvieme-victoire-de-suite-tc/"}],"fil":[{"id":"art-real-madrid-santos-a-tente-un-pret-de-rodrygo-cet-hiver-le-real-madrid","date":"2026-11-18T19:15:32.858Z","label":"rumeur","title":"Real Madrid : Santos a tenté un prêt de Rodrygo cet hiver, le Real Madrid a refusé, selon ESPN","text":"Le club formateur de l'ailier brésilien s'est renseigné sur un prêt, mais le Real Madrid compte sur lui pour son retour de blessure.","body":"Santos a pris contact avec le Real Madrid pour connaître les conditions d'un prêt de Rodrygo lors du mercato d'hiver, rapporte ESPN. La réponse madrilène a été rapide : le club et son entraîneur José Mourinho comptent sur l'ailier et n'envisagent aucun départ, même temporaire. Formé à Santos, le Brésilien de 25 ans est absent depuis une rupture du ligament croisé et une déchirure du ménisque subies en mars. Son retour à la compétition est attendu en janvier.","competition":"Liga","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/real-madrid-santos-a-tente-un-pret-de-rodrygo-cet-hiver-le-real-madrid/","url":"https://actusport24h.fr/fil-info/real-madrid-santos-a-tente-un-pret-de-rodrygo-cet-hiver-le-real-madrid/"},{"id":"art-real-madrid-santos-aimerait-recuperer-rodrygo-en-pret-cet-hiver-selon","date":"2026-11-18T10:00:21.000Z","label":"rumeur","title":"Real Madrid : Santos aimerait récupérer Rodrygo en prêt cet hiver, selon ESPN Brasil","text":"En fin de convalescence après sa rupture des ligaments croisés, l'ailier brésilien intéresse son club formateur.","body":"Opéré des ligaments croisés en mars, **Rodrygo** arrive au bout de sa rééducation, qu'il effectue actuellement au centre d'entraînement de **Santos**. Selon ESPN Brasil, son club formateur aimerait profiter de sa situation pour le récupérer en prêt de janvier à juin, et des premiers échanges auraient eu lieu avec le **Real Madrid**. À 25 ans, l'international brésilien (37 sélections, 9 buts) retrouvera une forte concurrence à Madrid, avec Arda Güler et Yan Diomandé sur le côté droit.","competition":"Liga","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/real-madrid-santos-aimerait-recuperer-rodrygo-en-pret-cet-hiver-selon/","url":"https://actusport24h.fr/fil-info/real-madrid-santos-aimerait-recuperer-rodrygo-en-pret-cet-hiver-selon/"},{"id":"art-real-madrid-rodrygo-opere-du-ligament-croise-en-mars-devrait-rejouer-a","date":"2026-11-15T20:33:10.612Z","label":"info","title":"Real Madrid : Rodrygo, opéré du ligament croisé en mars, devrait rejouer au plus tard en janvier","text":"Victime d'une rupture du ligament croisé antérieur du genou droit en mars, l'attaquant brésilien du Real Madrid voit le bout du tunnel : selon L'Équipe, son retour à la compétition est attendu au plus tard en janvier 2027.","body":null,"competition":"Liga","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/real-madrid-rodrygo-opere-du-ligament-croise-en-mars-devrait-rejouer-a/","url":"https://actusport24h.fr/fil-info/real-madrid-rodrygo-opere-du-ligament-croise-en-mars-devrait-rejouer-a/"}]}