d":false,"played":false,"in":null,"out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[{"slug":"sabah-fc-barcelone-1-4-double-d-anthony-gordon-le-barca-deroule-a-bako","title":"Sabah - FC Barcelone 1-4 : doublé d'Anthony Gordon, le Barça déroule à Bakou, ce qu'il faut retenir","hook":"Sans Lamine Yamal et avec Raphinha au repos au coup d'envoi, le FC Barcelone s'est imposé 4-1 au stade olympique de Bakou. Anthony Gordon, auteur d'un doublé, a mis les Catalans sur la voie d'une quatrième victoire en cinq journées de Ligue des champions.","date":"2026-11-26T09:35:49.461Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/sabah-fc-barcelone-1-4-double-d-anthony-gordon-le-barca-dero-e3a6888095.jpg","thumb":"https://actusport24h.fr/img/thumbs/sabah-fc-barcelone-1-4-double-d-anthony-gordon-le-barca-dero-e3a6888095.webp","imageAlt":"Gabriel Jesus, Karim Adeyemi et Anthony Gordon se félicitent lors de Sabah - FC Barcelone à Bakou, le 25 novembre 2026","credit":"© FC Barcelone","read":2,"tags":["Ligue des champions","FC Barcelone","Sabah","Anthony Gordon","Karim Adeyemi","Gabriel Jesus","Hansi Flick"],"url":"https://actusport24h.fr/article/sabah-fc-barcelone-1-4-double-d-anthony-gordon-le-barca-deroule-a-bako/"},{"slug":"barca-villarreal-kounde-et-cubarsi-de-retour-a-l-entrainement-flick-ve","title":"Barça - Villarreal : Koundé et Cubarsí de retour à l'entraînement, Flick veut garder ses trois points d'avance sur le Real Madrid","hook":"Leader de la Liga avec 33 points, le FC Barcelone reçoit Villarreal dimanche (14h) au Spotify Camp Nou pour la 13e journée. Hansi Flick récupère plusieurs cadres, mais sa défense reste son principal casse-tête face à un adversaire qui lui réussit mal depuis quelques saisons.","date":"2026-11-19T18:13:43.297Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/barca-villarreal-kounde-et-cubarsi-de-retour-a-l-entrainemen-6afa751e39.jpg","thumb":"https://actusport24h.fr/img/thumbs/barca-villarreal-kounde-et-cubarsi-de-retour-a-l-entrainemen-6afa751e39.webp","imageAlt":"Lamine Yamal, sous le maillot du FC Barcelone, face à un joueur de Villarreal lors d'une précédente confrontation au Spotify Camp Nou","credit":"© FC Barcelona","read":3,"tags":["Liga","FC Barcelone","Villarreal","Hansi Flick","Jules Koundé","Pau Cubarsí","Raphinha","Lamine Yamal","Deco","Iñigo Pérez"],"url":"https://actusport24h.fr/article/barca-villarreal-kounde-et-cubarsi-de-retour-a-l-entrainement-flick-ve/"},{"slug":"portugal-carlos-forbs-herite-du-numero-7-de-cristiano-ronaldo-face-au","title":"Portugal : Carlos Forbs hérite du numéro 7 de Cristiano Ronaldo face au Danemark","hook":"Pour le premier match du Portugal depuis la retraite internationale de Cristiano Ronaldo, c'est l'ailier du Club Bruges Carlos Forbs qui portera le mythique numéro 7, ce samedi soir à Braga contre le Danemark en Ligue des nations.","date":"2026-11-14T11:16:18.326Z","updated":"2026-11-14T14:40:00.000Z","section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"info","labelName":"Info","image":"https://actusport24h.fr/img/posts/forbs1.jpg","thumb":"https://actusport24h.fr/img/thumbs/forbs1.webp","imageAlt":"Carlos Forbs sous le maillot de la sélection du Portugal","credit":"© Photo DR via CabineSport / X","read":3,"tags":["Portugal","Cristiano Ronaldo","Carlos Forbs","Ligue des nations"],"url":"https://actusport24h.fr/article/portugal-carlos-forbs-herite-du-numero-7-de-cristiano-ronaldo-face-au/"}],"fil":[{"id":"art-portugal-filmer-le-patron-la-scene-entre-bruno-fernandes-et-joao-cance","date":"2026-11-18T14:23:00.000Z","label":"info","title":"Portugal : « filmer le patron », la scène entre Bruno Fernandes et João Cancelo qui fait jaser après le départ de Cristiano Ronaldo","text":"Après la victoire au pays de Galles (3-2), le milieu de Manchester United a désigné Cancelo, qui portait le brassard, au cameraman.","body":"Une scène d'après-match fait parler au **Portugal**. Mardi, après la victoire arrachée au pays de Galles (3-2) en Ligue des nations, **Bruno Fernandes** a demandé à un cameraman de « filmer le patron » en pointant **João Cancelo**. Le latéral, qui avait hérité du brassard après la sortie du milieu de Manchester United, a répondu hilare en le montrant. Les médias portugais y ont vu une pique envers **Cristiano Ronaldo**, ancien capitaine qui vient de prendre sa retraite internationale, et dont la mère avait critiqué la sélection.","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/portugal-filmer-le-patron-la-scene-entre-bruno-fernandes-et-joao-cance/","url":"https://actusport24h.fr/fil-info/portugal-filmer-le-patron-la-scene-entre-bruno-fernandes-et-joao-cance/"}]}