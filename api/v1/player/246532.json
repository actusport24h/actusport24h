:0,"rc":0,"og":0},{"mid":"401915313","date":"2026-10-21T19:00Z","comp":"uefa.champions","team":"86","home":true,"opp":{"id":"11420","name":"RB Leipzig","short":"RB Leipzig","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/11420.png"},"my":"4","op":"1","started":false,"played":true,"in":"78","out":null,"pos":null,"g":0,"a":1,"yc":0,"rc":0,"og":0},{"mid":"401882839","date":"2026-10-18T19:00Z","comp":"esp.1","team":"86","home":true,"opp":{"id":"243","name":"FC Séville","short":"FC Séville","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/243.png"},"my":"4","op":"1","started":false,"played":true,"in":"69","out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[{"slug":"maroc-achraf-hakimi-signe-un-double-et-une-passe-decisive-contre-le-ni","title":"Maroc : Achraf Hakimi signe un doublé et une passe décisive contre le Niger (5-1)","hook":"Le latéral droit du PSG a porté le Maroc, large vainqueur du Niger (5-1) vendredi soir à Casablanca, pour la 3e journée des éliminatoires de la CAN 2027. Les Lions de l'Atlas restent parfaits avec trois succès en trois matchs.","date":"2026-11-13T22:11:13.289Z","updated":"2026-11-13T22:14:59.399Z","section":"psg","sections":["psg","international"],"sectionName":"PSG","color":"#1B3A8C","sport":null,"label":"officiel","labelName":"Officiel","image":"https://actusport24h.fr/img/posts/hakimi.jpg","thumb":"https://actusport24h.fr/img/thumbs/hakimi.webp","imageAlt":"Achraf Hakimi sous le maillot du Maroc, brassard de capitaine","credit":"© Photo : via @FutbolHub_ sur X","read":2,"tags":["Achraf Hakimi","Maroc","Niger","CAN 2027","PSG"],"url":"https://actusport24h.fr/article/maroc-achraf-hakimi-signe-un-double-et-une-passe-decisive-contre-le-ni/"}],"fil":[{"id":"art-maroc-a-17-ans-et-306-jours-abdellah-ouazane-devient-le-plus-jeune-but","date":"2026-11-18T15:28:00.000Z","label":"info","title":"Maroc : à 17 ans et 306 jours, Abdellah Ouazane devient le plus jeune buteur de l'histoire des Lions de l'Atlas","text":"Le milieu offensif de l'Ajax a offert la victoire et la qualification pour la CAN 2027 face au Niger, pour sa première titularisation.","body":"Une première titularisation et déjà un record. Auteur de l'unique but face au **Niger** (1-0), mardi au stade Prince Moulay Abdallah de Rabat, **Abdellah Ouazane** est devenu le plus jeune buteur de l'histoire de l'**équipe du Maroc**, à 17 ans et 306 jours. Pour sa troisième sélection, le milieu offensif de l'**Ajax**, né à Amsterdam, a conclu un une-deux avec **Brahim Díaz** à la 22e minute, un but qui assure aux Lions de l'Atlas leur billet pour la **CAN 2027**. Meilleur joueur de la CAN U17 remportée par le Maroc l'an passé, il avait été tout près de rejoindre le Real Madrid l'été dernier avant que le transfert n'échoue après la visite médicale.","competition":"CAN","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/maroc-a-17-ans-et-306-jours-abdellah-ouazane-devient-le-plus-jeune-but/","url":"https://actusport24h.fr/fil-info/maroc-a-17-ans-et-306-jours-abdellah-ouazane-devient-le-plus-jeune-but/"},{"id":"art-eliminatoires-can-2027-le-maroc-bat-le-niger-1-0-et-valide-sa-qualific","date":"2026-11-17T21:59:00.000Z","label":"info","title":"Éliminatoires CAN 2027 : le Maroc bat le Niger (1-0) et valide sa qualification","text":"Les Lions de l'Atlas ont assuré leur billet pour la phase finale avec un quatrième succès en quatre matchs.","body":"Le Maroc n'a pas brillé, mais il a fait le travail. Mardi soir, la sélection marocaine a battu le Niger 1-0 lors de la 4e journée des éliminatoires de la CAN 2027. Le jeune Abdellah Ouazane a inscrit l'unique but en première période, à la conclusion d'une action menée avec Brahim Díaz. Avec 12 points en quatre matchs, le Maroc caracole en tête du groupe A et rejoint la liste des sélections déjà assurées de disputer la phase finale.","competition":"CAN","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/eliminatoires-can-2027-le-maroc-bat-le-niger-1-0-et-valide-sa-qualific/","url":"https://actusport24h.fr/fil-info/eliminatoires-can-2027-le-maroc-bat-le-niger-1-0-et-valide-sa-qualific/"}]}