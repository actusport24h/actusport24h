,"out":null,"pos":"Défenseur central droit","g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401861092","date":"2026-09-29T18:45Z","comp":"uefa.nations","team":"448","home":false,"opp":{"id":"450","name":"Tchéquie","short":"Tchéquie","logo":"https://a.espncdn.com/i/teamlogos/countries/500/cze.png"},"my":"2","op":"0","started":false,"played":false,"in":null,"out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[{"slug":"premier-league-arsenal-a-27-points-brighton-dauphin-manchester-united","title":"Premier League : Arsenal à 27 points, Brighton dauphin, Manchester United 18e… le bilan après dix journées","hook":"Neuf victoires en dix matchs, sept clean sheets et cinq points d'avance : Arsenal aborde la reprise de samedi en patron. Derrière, Brighton bouscule la hiérarchie tandis que Manchester United, 18e, lance l'ère Pochettino à Anfield.","date":"2026-11-18T21:41:57.349Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/premier-league-arsenal-a-27-points-brighton-dauphin-manchest-e46fdae4be.jpg","thumb":"https://actusport24h.fr/img/thumbs/premier-league-arsenal-a-27-points-brighton-dauphin-manchest-e46fdae4be.webp","imageAlt":"Martin Ødegaard célèbre son but avec Arsenal à l'Emirates Stadium","credit":"© Arsenal FC","read":2,"tags":["Premier League","Arsenal","Brighton","Manchester City","Manchester United","Mauricio Pochettino","Martin Ødegaard","Liverpool"],"url":"https://actusport24h.fr/article/premier-league-arsenal-a-27-points-brighton-dauphin-manchester-united/"},{"slug":"espagne-angleterre-2-3-l-angleterre-fait-tomber-les-champions-du-monde","title":"Espagne-Angleterre (2-3) : l'Angleterre fait tomber les champions du monde à Madrid et termine en tête de son groupe","hook":"Menée 3-0 après une heure de jeu, l'Espagne s'est rebiffée face à des Anglais réduits à dix, sans pouvoir éviter sa première défaite depuis 43 matchs. Grâce à cette victoire au Metropolitano, l'Angleterre de Thomas Tuchel finit première du groupe 3 de la Ligue des nations.","date":"2026-11-15T21:50:23.119Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/espagne-angleterre-2-3-l-angleterre-fait-tomber-les-champion-3360f5fbde.jpg","thumb":"https://actusport24h.fr/img/thumbs/espagne-angleterre-2-3-l-angleterre-fait-tomber-les-champion-3360f5fbde.webp","imageAlt":"Jude Bellingham lève le poing aux côtés de Harry Kane après la victoire de l'Angleterre en Espagne (2-3)","credit":"© England (@England sur X)","read":3,"tags":["Ligue des nations","Espagne","Angleterre","Harry Kane","Ezri Konsa","Ben White","Jude Bellingham","Elliot Anderson","Lamine Yamal","Nico Williams","Mikel Oyarzabal","Thomas Tuchel","Luis de la Fuente"],"url":"https://actusport24h.fr/article/espagne-angleterre-2-3-l-angleterre-fait-tomber-les-champions-du-monde/"},{"slug":"espagne-angleterre-lamine-yamal-et-oyarzabal-de-retour-tuchel-parle-d","title":"Espagne - Angleterre : Lamine Yamal et Oyarzabal de retour, Tuchel parle d'une « finale » pour la première place","hook":"Dimanche au Metropolitano, l'Espagne reçoit l'Angleterre pour la première place du groupe A3 de la Ligue des nations. Luis de la Fuente récupère ses deux attaquants, Thomas Tuchel promet une équipe conquérante.","date":"2026-11-14T07:20:21.586Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"info","labelName":"Info","image":"https://actusport24h.fr/img/posts/delafuente.jpg","thumb":"https://actusport24h.fr/img/thumbs/delafuente.webp","imageAlt":"Luis de la Fuente, sélectionneur de l'Espagne, avant Tchéquie - Espagne en Ligue des nations","credit":"© Reuters / David W Cerny via Flashscore","read":3,"tags":["Ligue des nations","Espagne","Angleterre","Lamine Yamal","Mikel Oyarzabal","Thomas Tuchel","Luis de la Fuente"],"url":"https://actusport24h.fr/article/espagne-angleterre-lamine-yamal-et-oyarzabal-de-retour-tuchel-parle-d/"}],"fil":[{"id":"art-arsenal-william-saliba-de-retour-a-l-entrainement-mikel-arteta-face-au","date":"2026-11-18T09:55:26.830Z","label":"info","title":"Arsenal : William Saliba de retour à l'entraînement, Mikel Arteta face au dilemme Ezri Konsa","text":"Le défenseur des Bleus se rapproche d'un retour, alors que sa doublure a brillé en son absence.","body":"Blessé ces dernières semaines, **William Saliba** a repris l'entraînement avec **Arsenal** et monte en puissance. Son retour pose un choix délicat à **Mikel Arteta** : arrivé d'Aston Villa l'été dernier, **Ezri Konsa** a parfaitement assuré l'intérim aux côtés de Gabriel, au point de figurer parmi les meilleurs défenseurs de Premier League en matière de précision des passes et de duels gagnés. Le calendrier d'avant Noël, avec Dortmund, Manchester City, Tottenham, le Real Madrid et Manchester United, imposera des choix.","competition":"Premier League","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/arsenal-william-saliba-de-retour-a-l-entrainement-mikel-arteta-face-au/","url":"https://actusport24h.fr/fil-info/arsenal-william-saliba-de-retour-a-l-entrainement-mikel-arteta-face-au/"},{"id":"art-espagne-angleterre-2-3-l-angleterre-fait-tomber-les-champions-du-monde","date":"2026-11-15T21:50:23.119Z","label":"analyse","title":"Espagne-Angleterre (2-3) : l'Angleterre fait tomber les champions du monde à Madrid et termine en tête de son groupe","text":"Menée 3-0 après une heure de jeu, l'Espagne s'est rebiffée face à des Anglais réduits à dix, sans pouvoir éviter sa première défaite depuis 43 matchs. Grâce à cette victoire au Metropolitano, l'Angleterre de Thomas Tuchel finit première du groupe 3 de la Ligue des nations.","body":null,"competition":"Ligue des nations","articleSlug":"espagne-angleterre-2-3-l-angleterre-fait-tomber-les-champions-du-monde","pageUrl":"https://actusport24h.fr/fil-info/espagne-angleterre-2-3-l-angleterre-fait-tomber-les-champions-du-monde/","url":"https://actusport24h.fr/article/espagne-angleterre-2-3-l-angleterre-fait-tomber-les-champions-du-monde/"}]}