:null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401915425","date":"2026-09-08T19:00Z","comp":"uefa.champions","team":"382","home":false,"opp":{"id":"437","name":"FC Porto","short":"FC Porto","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/437.png"},"my":"2","op":"0","started":false,"played":false,"in":null,"out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[{"slug":"manchester-city-gianluigi-donnarumma-ne-serait-plus-dans-les-plans-des","title":"Manchester City : Gianluigi Donnarumma ne serait plus dans les plans des Citizens, un départ envisagé dès l'été prochain","hook":"Arrivé du PSG à l'été 2025 et lié à Manchester City jusqu'en 2030, le gardien italien ne correspondrait plus au jeu voulu par le club anglais, selon The Athletic. Geronimo Rulli serait lui aussi sur la sellette.","date":"2026-11-27T12:18:15.636Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"rumeur","labelName":"Rumeur","image":"https://actusport24h.fr/img/posts/manchester-city-gianluigi-donnarumma-ne-serait-plus-dans-les-bed0fc4865.jpg","thumb":"https://actusport24h.fr/img/thumbs/manchester-city-gianluigi-donnarumma-ne-serait-plus-dans-les-bed0fc4865.webp","imageAlt":"Gianluigi Donnarumma enlace Erling Haaland sous le maillot de Manchester City","credit":"© Maxppp","read":2,"tags":["Premier League","Manchester City","Gianluigi Donnarumma","Geronimo Rulli","PSG","Mercato"],"url":"https://actusport24h.fr/article/manchester-city-gianluigi-donnarumma-ne-serait-plus-dans-les-plans-des/"},{"slug":"om-jeffrey-de-lange-le-gardien-qui-evite-le-plus-de-buts-en-europe-rem","title":"OM : Jeffrey de Lange, le gardien qui évite le plus de buts en Europe, rempart d'une défense trop exposée","hook":"Contesté en début de saison, Jeffrey de Lange est devenu l'un des hommes forts de l'OM. Ses chiffres le placent tout en haut des cinq grands championnats, mais ils révèlent aussi la fragilité défensive marseillaise.","date":"2026-11-25T08:32:43.345Z","updated":null,"section":"ligue-1","sections":["ligue-1","om"],"sectionName":"Ligue 1","color":"#0E9384","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/om-jeffrey-de-lange-le-gardien-qui-evite-le-plus-de-buts-en--bfa4f28c2b.jpg","thumb":"https://actusport24h.fr/img/thumbs/om-jeffrey-de-lange-le-gardien-qui-evite-le-plus-de-buts-en--bfa4f28c2b.webp","imageAlt":"Jeffrey de Lange, gardien de l'OM, dans ses buts au Vélodrome","credit":"© Maxifoot","read":3,"tags":["Ligue 1","OM","Jeffrey de Lange","Bruno Genesio","Gardien","Statistiques"],"url":"https://actusport24h.fr/article/om-jeffrey-de-lange-le-gardien-qui-evite-le-plus-de-buts-en-europe-rem/"},{"slug":"argentine-uruguay-1-2-premiere-defaite-de-l-ere-post-messi-a-la-bombon","title":"Argentine - Uruguay (1-2) : première défaite de l'ère post-Messi à la Bombonera","hook":"Pour son premier match depuis la retraite internationale de Lionel Messi, l'Argentine s'est inclinée 2-1 face à l'Uruguay en amical, vendredi soir à la Bombonera. Un but contre son camp de Leonardo Balerdi a lancé la Celeste.","date":"2026-11-14T07:19:17.557Z","updated":"2026-11-14T07:26:34.092Z","section":"international","sections":["international"],"sectionName":"International","color":"#DC6803","sport":null,"label":"info","labelName":"Info","image":"https://actusport24h.fr/img/posts/arg-uru-afa.jpg","thumb":"https://actusport24h.fr/img/thumbs/arg-uru-afa.webp","imageAlt":"Julián Álvarez (Argentine) face à deux joueurs uruguayens à la Bombonera","credit":"© Photo : AFA (Asociación del Fútbol Argentino)","read":2,"tags":["Argentine","Uruguay","Messi","Balerdi","Julián Álvarez","Match amical"],"url":"https://actusport24h.fr/article/argentine-uruguay-1-2-premiere-defaite-de-l-ere-post-messi-a-la-bombon/"}],"fil":[{"id":"art-manchester-city-gianluigi-donnarumma-ne-serait-plus-dans-les-plans-des","date":"2026-11-27T12:18:15.636Z","label":"rumeur","title":"Manchester City : Gianluigi Donnarumma ne serait plus dans les plans des Citizens, un départ envisagé dès l'été prochain","text":"Arrivé du PSG à l'été 2025 et lié à Manchester City jusqu'en 2030, le gardien italien ne correspondrait plus au jeu voulu par le club anglais, selon The Athletic. Geronimo Rulli serait lui aussi sur la sellette.","body":null,"competition":"Premier League","articleSlug":"manchester-city-gianluigi-donnarumma-ne-serait-plus-dans-les-plans-des","pageUrl":"https://actusport24h.fr/fil-info/manchester-city-gianluigi-donnarumma-ne-serait-plus-dans-les-plans-des/","url":"https://actusport24h.fr/article/manchester-city-gianluigi-donnarumma-ne-serait-plus-dans-les-plans-des/"},{"id":"art-om-trois-ans-sur-le-banc-ca-n-aurait-ete-bon-ni-pour-moi-ni-pour-l-om","date":"2026-11-17T18:27:00.000Z","label":"info","title":"OM : « Trois ans sur le banc, ça n'aurait été bon ni pour moi, ni pour l'OM », Jeffrey de Lange revient sur son statut de numéro un","text":"Devenu titulaire après le départ de Gerónimo Rulli, le gardien néerlandais explique avoir réclamé du temps de jeu cet été.","body":"Jeffrey de Lange assume son nouveau statut. Promu numéro un de l'OM après le départ de Gerónimo Rulli lors du mercato estival, le gardien néerlandais de 28 ans (10 matchs de Ligue 1 cette saison) a expliqué à l'AFP avoir dit au club cet été qu'il devait jouer : « Trois ans sur le banc, ça n'aurait été bon ni pour moi, ni pour l'OM. » Il reconnaît avoir dû s'adapter au manque de rythme en début de saison, en suivant les conseils de l'entraîneur des gardiens Nicolas Dehon : « Jeff, tranquille, pas à pas. »","competition":"Ligue 1","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/om-trois-ans-sur-le-banc-ca-n-aurait-ete-bon-ni-pour-moi-ni-pour-l-om/","url":"https://actusport24h.fr/fil-info/om-trois-ans-sur-le-banc-ca-n-aurait-ete-bon-ni-pour-moi-ni-pour-l-om/"}]}