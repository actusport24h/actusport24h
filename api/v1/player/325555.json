,"articles":[{"slug":"ipswich-aston-villa-six-matchs-sans-victoire-matty-cash-de-retour-un-5","title":"Ipswich - Aston Villa : six matchs sans victoire, Matty Cash de retour, un 5 000e match historique… l'Aston Villa d'Unai Emery sous pression à Portman Road","hook":"Douzième de Premier League et muet en attaque depuis plusieurs semaines, Aston Villa se déplace samedi (18h30) à Ipswich, 16e, avec l'obligation de relancer sa saison. Les Tractor Boys, eux, n'ont plus gagné depuis cinq journées.","date":"2026-11-28T08:20:03.225Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/ipswich-aston-villa-six-matchs-sans-victoire-matty-cash-de-r-3cdf5e10d8.jpg","thumb":"https://actusport24h.fr/img/thumbs/ipswich-aston-villa-six-matchs-sans-victoire-matty-cash-de-r-3cdf5e10d8.webp","imageAlt":"Matty Cash, latéral droit d'Aston Villa, donne des consignes sur le terrain","credit":"© Aston Villa FC","read":3,"tags":["Premier League","Aston Villa","Ipswich Town","Unai Emery","Gary O'Neil","Matty Cash","Alejandro Garnacho","Ipswich - Aston Villa"],"url":"https://actusport24h.fr/article/ipswich-aston-villa-six-matchs-sans-victoire-matty-cash-de-retour-un-5/"}],"fil":[{"id":"art-ipswich-aston-villa-six-matchs-sans-victoire-matty-cash-de-retour-un-5","date":"2026-11-28T08:20:03.225Z","label":"analyse","title":"Ipswich - Aston Villa : six matchs sans victoire, Matty Cash de retour, un 5 000e match historique… l'Aston Villa d'Unai Emery sous pression à Portman Road","text":"Douzième de Premier League et muet en attaque depuis plusieurs semaines, Aston Villa se déplace samedi (18h30) à Ipswich, 16e, avec l'obligation de relancer sa saison. Les Tractor Boys, eux, n'ont plus gagné depuis cinq journées.","body":null,"competition":"Premier League","articleSlug":"ipswich-aston-villa-six-matchs-sans-victoire-matty-cash-de-retour-un-5","pageUrl":"https://actusport24h.fr/fil-info/ipswich-aston-villa-six-matchs-sans-victoire-matty-cash-de-retour-un-5/","url":"https://actusport24h.fr/article/ipswich-aston-villa-six-matchs-sans-victoire-matty-cash-de-retour-un-5/"},{"id":"art-aston-villa-ceux-que-je-considere-comme-les-meilleurs-unai-emery-justi","date":"2026-11-25T14:29:00.000Z","label":"info","title":"Aston Villa : « Ceux que je considère comme les meilleurs », Unai Emery justifie la nouvelle mise à l'écart d'Alejandro Garnacho","text":"L'ailier argentin, prêté par Chelsea, n'a pas été retenu à Istanbul malgré une place libre sur le banc.","body":"Battu par **Galatasaray (1-0)** mardi en Ligue des champions, **Aston Villa** s'est encore passé d'**Alejandro Garnacho**. Prêté par Chelsea l'été dernier avec une obligation d'achat liée à son nombre d'apparitions, l'Argentin de 22 ans était absent de la feuille de match alors qu'une place restait disponible sur le banc. « Les joueurs présents aujourd'hui sont ceux que je considère comme les meilleurs pour être avec nous », a tranché **Unai Emery**. Déjà absent des deux dernières journées de Premier League, Garnacho n'a toujours pas été titularisé par l'Espagnol.","competition":"Ligue des champions","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/aston-villa-ceux-que-je-considere-comme-les-meilleurs-unai-emery-justi/","url":"https://actusport24h.fr/fil-info/aston-villa-ceux-que-je-considere-comme-les-meilleurs-unai-emery-justi/"}]}