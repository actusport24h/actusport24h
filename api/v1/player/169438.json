e":"Racing Santander","short":"Racing","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/87.png"},"my":"3","op":"0","started":false,"played":false,"in":null,"out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401882832","date":"2026-10-25T20:00Z","comp":"esp.1","team":"86","home":false,"opp":{"id":"83","name":"FC Barcelone","short":"FC Barcelone","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/83.png"},"my":"2","op":"1","started":false,"played":false,"in":null,"out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401915313","date":"2026-10-21T19:00Z","comp":"uefa.champions","team":"86","home":true,"opp":{"id":"11420","name":"RB Leipzig","short":"RB Leipzig","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/11420.png"},"my":"4","op":"1","started":true,"played":true,"in":null,"out":null,"pos":"Défenseur central droit","g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401882839","date":"2026-10-18T19:00Z","comp":"esp.1","team":"86","home":true,"opp":{"id":"243","name":"FC Séville","short":"FC Séville","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/243.png"},"my":"4","op":"1","started":false,"played":false,"in":null,"out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[{"slug":"real-madrid-psv-5-1-bellingham-change-tout-double-de-mbappe-ce-qu-il-f","title":"Real Madrid - PSV (5-1) : Bellingham change tout, doublé de Mbappé… ce qu'il faut retenir du récital madrilène","hook":"Mené à la pause sur un penalty d'Ivan Perišić, le Real Madrid de José Mourinho a inscrit cinq buts en seconde période au Santiago-Bernabéu. Cinq victoires en cinq matchs : les Merengues sont seuls en tête de la Ligue des champions, en attendant le PSG.","date":"2026-11-24T22:14:07.856Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/real-madrid-psv-5-1-bellingham-change-tout-double-de-mbappe--e227bccb04.jpg","thumb":"https://actusport24h.fr/img/thumbs/real-madrid-psv-5-1-bellingham-change-tout-double-de-mbappe--e227bccb04.webp","imageAlt":"Kylian Mbappé lève le doigt pour célébrer un but avec le Real Madrid au Santiago-Bernabéu face au PSV","credit":"© Real Madrid","read":3,"tags":["Ligue des champions","Real Madrid","PSV Eindhoven","Kylian Mbappé","Jude Bellingham","José Mourinho","Arda Güler","Federico Valverde","Vinícius Júnior"],"url":"https://actusport24h.fr/article/real-madrid-psv-5-1-bellingham-change-tout-double-de-mbappe-ce-qu-il-f/"}],"fil":[{"id":"art-real-madrid-remplacant-lors-des-quatre-derniers-matchs-de-liga-antonio","date":"2026-11-18T16:52:06.760Z","label":"info","title":"Real Madrid : remplaçant lors des quatre derniers matchs de Liga, Antonio Rüdiger ne tient pas rigueur à José Mourinho","text":"Dans un entretien à The Athletic, le défenseur allemand voit en l'entraîneur portugais l'homme qu'il faut pour relancer le Real.","body":"Resté sur le banc lors des quatre dernières journées de Liga, **Antonio Rüdiger** ne fait pas de procès à **José Mourinho**. Dans un entretien accordé à **The Athletic** et relayé par **Maxifoot**, le défenseur central de 33 ans (7 matchs et 2 buts cette saison toutes compétitions confondues) raconte avoir reçu un appel du technicien portugais peu avant la fin de la saison dernière : Mourinho lui annonçait qu'il serait le prochain entraîneur du **Real Madrid** et qu'il souhaitait le garder. Rüdiger estime que son coach a hérité d'un groupe équilibré et qu'il sait construire une équipe pour gagner, peu importe qui débute les matchs. Il le décrit aussi comme un blagueur dans le vestiaire, mais intransigeant une fois sur le terrain.","competition":"Liga","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/real-madrid-remplacant-lors-des-quatre-derniers-matchs-de-liga-antonio/","url":"https://actusport24h.fr/fil-info/real-madrid-remplacant-lors-des-quatre-derniers-matchs-de-liga-antonio/"},{"id":"art-real-madrid-deux-ans-sans-gagner-c-est-horrible-antonio-rudiger-defend","date":"2026-11-18T08:59:35.169Z","label":"info","title":"Real Madrid : « Deux ans sans gagner, c'est horrible », Antonio Rüdiger défend Kylian Mbappé et Vinícius dans The Athletic","text":"Le défenseur allemand assume l'identité d'un vestiaire de stars et refuse de reprocher à Mbappé son travail défensif.","body":"Dans un entretien accordé à The Athletic, Antonio Rüdiger juge « horrible » de passer deux ans sans rien gagner au Real Madrid. Le défenseur balaie les critiques visant Kylian Mbappé : il ne voit pas l'intérêt de demander des efforts défensifs à un attaquant qui a franchi la barre des 100 buts avec le club. Il soutient aussi Vinícius, qu'il voit travailler dur pour redresser la barre, admet que la gestion des ego fait partie de l'histoire madrilène et dit avoir présenté ses excuses aux arbitres après ses débordements contre le Barça.","competition":"Liga","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/real-madrid-deux-ans-sans-gagner-c-est-horrible-antonio-rudiger-defend/","url":"https://actusport24h.fr/fil-info/real-madrid-deux-ans-sans-gagner-c-est-horrible-antonio-rudiger-defend/"}]}