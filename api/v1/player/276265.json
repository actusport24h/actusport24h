//a.espncdn.com/i/teamlogos/countries/500/ita.png"},"my":"2","op":"0","started":false,"played":false,"in":null,"out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[{"slug":"ol-sulc-morton-openda-l-infirmerie-de-carlos-vicens-avant-ses-debuts-e","title":"OL : Šulc, Morton, Openda... l'infirmerie de Carlos Vicens avant ses débuts en Ligue 1 à Lille","hook":"Nommé le 9 novembre, Carlos Vicens fera ses débuts sur le banc lyonnais samedi à Lille, pour la 11e journée de Ligue 1. Le technicien espagnol devra composer avec plusieurs absences de poids, au milieu comme en attaque.","date":"2026-11-16T14:20:09.993Z","updated":null,"section":"ligue-1","sections":["ligue-1"],"sectionName":"Ligue 1","color":"#0E9384","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/ol-sulc-morton-openda-l-infirmerie-de-carlos-vicens-avant-se-a4252d9dec.jpg","thumb":"https://actusport24h.fr/img/thumbs/ol-sulc-morton-openda-l-infirmerie-de-carlos-vicens-avant-se-a4252d9dec.webp","imageAlt":"Carlos Vicens présenté avec le maillot de l'Olympique Lyonnais","credit":"© Olympique Lyonnais","read":2,"tags":["OL","Carlos Vicens","Pavel Šulc","Loïs Openda","Tyler Morton","LOSC","blessure"],"url":"https://actusport24h.fr/article/ol-sulc-morton-openda-l-infirmerie-de-carlos-vicens-avant-ses-debuts-e/"}],"fil":[{"id":"art-ol-lois-openda-repond-aux-rumeurs-de-retour-a-la-juventus-en-posant-av","date":"2026-11-18T17:01:00.000Z","label":"info","title":"OL : Loïs Openda répond aux rumeurs de retour à la Juventus en posant avec le maillot lyonnais","text":"Annoncé sur le départ cet hiver par la presse italienne, l'attaquant belge prêté par la Juventus affiche son attachement aux Gones.","body":"**Loïs Openda** a choisi les réseaux sociaux pour couper court aux bruits de couloir. Ce mercredi, l'attaquant belge de 26 ans a publié une photo de lui sous le maillot de l'**Olympique Lyonnais**, une manière de signifier qu'il se projette toujours avec le club, rapporte **Foot Mercato**. La presse italienne évoquait ces derniers jours un retour anticipé à la **Juventus**, qui l'a prêté à l'OL l'été dernier, dès le mercato de janvier. Auteur de deux buts et d'une passe décisive en dix matchs, Openda n'a plus joué depuis le 9 octobre et la rencontre face à Lens, en raison d'une fracture du péroné, mais son retour se rapproche.","competition":"Ligue 1","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ol-lois-openda-repond-aux-rumeurs-de-retour-a-la-juventus-en-posant-av/","url":"https://actusport24h.fr/fil-info/ol-lois-openda-repond-aux-rumeurs-de-retour-a-la-juventus-en-posant-av/"},{"id":"art-mercato-ol-lyon-pret-a-rendre-lois-openda-a-la-juventus-des-cet-hiver","date":"2026-11-17T16:02:00.000Z","label":"rumeur","title":"Mercato OL : Lyon prêt à rendre Loïs Openda à la Juventus dès cet hiver, selon La Gazzetta dello Sport","text":"Prêté par la Juventus, l'attaquant belge ne serait plus dans les plans lyonnais, d'après le quotidien italien.","body":"Loïs Openda pourrait quitter l'OL dès janvier. La Gazzetta dello Sport assure que le club lyonnais a fait savoir à la Juventus qu'il ne comptait pas conserver l'attaquant belge de 26 ans, prêté cette saison, sa blessure au péroné et le changement d'entraîneur l'ayant éloigné du projet. Le joueur ne figurerait pas non plus dans les plans de Luciano Spalletti à Turin. Openda compte 2 buts et 1 passe décisive en 10 matchs avec Lyon. Ni l'OL ni la Juventus n'ont réagi.","competition":"Mercato","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/mercato-ol-lyon-pret-a-rendre-lois-openda-a-la-juventus-des-cet-hiver/","url":"https://actusport24h.fr/fil-info/mercato-ol-lyon-pret-a-rendre-lois-openda-a-la-juventus-des-cet-hiver/"},{"id":"art-ol-sulc-morton-openda-l-infirmerie-de-carlos-vicens-avant-ses-debuts-e","date":"2026-11-16T14:20:09.993Z","label":"analyse","title":"OL : Šulc, Morton, Openda... l'infirmerie de Carlos Vicens avant ses débuts en Ligue 1 à Lille","text":"Nommé le 9 novembre, Carlos Vicens fera ses débuts sur le banc lyonnais samedi à Lille, pour la 11e journée de Ligue 1. Le technicien espagnol devra composer avec plusieurs absences de poids, au milieu comme en attaque.","body":null,"competition":"Ligue 1","articleSlug":"ol-sulc-morton-openda-l-infirmerie-de-carlos-vicens-avant-ses-debuts-e","pageUrl":"https://actusport24h.fr/fil-info/ol-sulc-morton-openda-l-infirmerie-de-carlos-vicens-avant-ses-debuts-e/","url":"https://actusport24h.fr/article/ol-sulc-morton-openda-l-infirmerie-de-carlos-vicens-avant-ses-debuts-e/"}]}