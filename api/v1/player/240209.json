pncdn.com/i/teamlogos/soccer/500/104.png"},"my":"1","op":"1","started":true,"played":true,"in":null,"out":"72","pos":"Attaquant","g":0,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[{"slug":"sporting-manchester-united-2-2-trois-penalties-un-but-sur-faux-rebond","title":"Sporting - Manchester United (2-2) : trois penalties, un but sur faux rebond et Lammens en cauchemar… ce qu'il faut retenir de la soirée européenne","hook":"À Lisbonne, Manchester United a cru tenir sa première victoire sous Mauricio Pochettino avant de se faire rejoindre à dix minutes de la fin. Ailleurs, l'Inter et l'Atlético ont respiré, Fenerbahçe a gagné chez le Shakhtar et le Barça a déroulé à Bakou.","date":"2026-11-26T07:29:06.148Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/sporting-manchester-united-2-2-trois-penalties-un-but-sur-fa-e757c8e719.jpg","thumb":"https://actusport24h.fr/img/thumbs/sporting-manchester-united-2-2-trois-penalties-un-but-sur-fa-e757c8e719.webp","imageAlt":"Luis Suárez (Sporting) célèbre son égalisation devant des joueurs de Manchester United, le 25 novembre 2026 à l'Estádio José Alvalade","credit":"© Patricia de Melo Moreira / AFP","read":3,"tags":["Ligue des champions","Sporting CP","Manchester United","Bruno Fernandes","Luis Suárez","Senne Lammens","Mauricio Pochettino","Inter Milan","Atlético de Madrid","Fenerbahçe","FC Barcelone","Villarreal"],"url":"https://actusport24h.fr/article/sporting-manchester-united-2-2-trois-penalties-un-but-sur-faux-rebond/"},{"slug":"shakhtar-donetsk-fenerbahce-kante-et-guendouzi-a-stamford-bridge-un-du","title":"Shakhtar Donetsk - Fenerbahçe : Kanté et Guendouzi à Stamford Bridge, un duel Arda Turan - Emre Belözoğlu pour les barrages","hook":"Mercredi (21h), le Shakhtar reçoit Fenerbahçe à Londres, son terrain d'exil européen. Avec 4 et 5 points, les deux clubs jouent une place dans le top 24 de la Ligue des champions.","date":"2026-11-24T21:58:26.022Z","updated":null,"section":"europe","sections":["europe"],"sectionName":"Europe","color":"#7A5AF8","sport":null,"label":"analyse","labelName":"Analyse","image":"https://actusport24h.fr/img/posts/shakhtar-donetsk-fenerbahce-kante-et-guendouzi-a-stamford-br-0e597a203c.jpg","thumb":"https://actusport24h.fr/img/thumbs/shakhtar-donetsk-fenerbahce-kante-et-guendouzi-a-stamford-br-0e597a203c.webp","imageAlt":"N'Golo Kanté et l'entraîneur Emre Belözoğlu en conférence de presse de Fenerbahçe avant Shakhtar Donetsk","credit":"© Fenerbahçe SK","read":3,"tags":["Ligue des champions","Shakhtar Donetsk","Fenerbahçe","N'Golo Kanté","Mattéo Guendouzi","Arda Turan","Emre Belözoğlu","Mason Greenwood"],"url":"https://actusport24h.fr/article/shakhtar-donetsk-fenerbahce-kante-et-guendouzi-a-stamford-bridge-un-du/"}],"fil":[{"id":"art-fenerbahce-mason-greenwood-seul-joueur-sans-enfant-d-escorte-a-stamfor","date":"2026-11-26T17:42:00.000Z","label":"info","title":"Fenerbahçe : Mason Greenwood seul joueur sans enfant d'escorte à Stamford Bridge avant Shakhtar - Fenerbahçe","text":"L'ancien Marseillais est entré sur la pelouse sans être accompagné, contrairement à tous les autres joueurs, avant la victoire turque en Ligue des champions.","body":"Scène inhabituelle mercredi à **Stamford Bridge**, où le **Shakhtar Donetsk** recevait **Fenerbahçe** en Ligue des champions. Lors du protocole d'avant-match, **Mason Greenwood** (25 ans) a été le seul joueur à entrer sur la pelouse sans enfant d'escorte, sans qu'aucune explication ne soit donnée. Le public londonien ne lui a en revanche pas réservé d'accueil hostile, contrairement à son déplacement à Aston Villa en octobre. L'ex-attaquant de l'OM a participé à l'action du seul but de la rencontre, signé **Vedat Muriqi** (0-1).","competition":"Ligue des champions","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/fenerbahce-mason-greenwood-seul-joueur-sans-enfant-d-escorte-a-stamfor/","url":"https://actusport24h.fr/fil-info/fenerbahce-mason-greenwood-seul-joueur-sans-enfant-d-escorte-a-stamfor/"},{"id":"art-ligue-des-champions-vedat-muriqi-offre-la-victoire-a-fenerbahce-face-a","date":"2026-11-25T21:57:00.000Z","label":"info","title":"Ligue des champions : Vedat Muriqi offre la victoire à Fenerbahçe face au Shakhtar Donetsk (0-1)","text":"Fenerbahçe s'est imposé sur la pelouse du Shakhtar Donetsk (0-1) mercredi, pour la 5e journée de la phase de ligue.","body":"Fenerbahçe s'est imposé sur la pelouse du Shakhtar Donetsk (0-1) mercredi, pour la 5e journée de la phase de ligue. L'unique but de la rencontre a été inscrit par l'attaquant kosovar **Vedat Muriqi** à la 56e minute. Le club stambouliote grimpe à la 16e place avec 8 points, le Shakhtar est 26e avec 4 points, hors de la zone des barrages.","competition":"Ligue des champions","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-champions-vedat-muriqi-offre-la-victoire-a-fenerbahce-face-a/","url":"https://actusport24h.fr/fil-info/ligue-des-champions-vedat-muriqi-offre-la-victoire-a-fenerbahce-face-a/"}]}