ue,"in":null,"out":null,"pos":"Gardien","g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401876433","date":"2026-10-18T15:15Z","comp":"fra.1","team":"169","home":false,"opp":{"id":"6851","name":"Paris FC","short":"Paris FC","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/6851.png"},"my":"3","op":"4","started":true,"played":true,"in":null,"out":null,"pos":"Gardien","g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401876441","date":"2026-10-11T15:15Z","comp":"fra.1","team":"169","home":true,"opp":{"id":"172","name":"AJ Auxerre","short":"Auxerre","logo":"https://a.espncdn.com/i/teamlogos/soccer/500/172.png"},"my":"4","op":"1","started":true,"played":true,"in":null,"out":null,"pos":"Gardien","g":0,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[{"slug":"toulouse-rennes-rongier-camara-et-samba-incertains-cresswell-et-thomas","title":"Toulouse - Rennes : Rongier, Camara et Samba incertains, Cresswell et Thomasson absents… le troisième intérim de Sébastien Tambouret commence dans le flou","hook":"Au lendemain de la mise à pied de Franck Haise, l'entraîneur de la réserve rennaise s'est présenté en conférence de presse ce samedi. À la veille du déplacement à Toulouse (dimanche, 17h15), il attend encore de connaître son groupe.","date":"2026-11-28T12:55:14.528Z","updated":null,"section":"ligue-1","sections":["ligue-1"],"sectionName":"Ligue 1","color":"#0E9384","sport":null,"label":"info","labelName":"Info","image":"https://actusport24h.fr/img/posts/toulouse-rennes-rongier-camara-et-samba-incertains-cresswell-b12c98ba8d.jpg","thumb":"https://actusport24h.fr/img/thumbs/toulouse-rennes-rongier-camara-et-samba-incertains-cresswell-b12c98ba8d.webp","imageAlt":"Valentin Rongier sous le maillot du Stade Rennais au Roazhon Park","credit":"© Ouest-France","read":3,"tags":["Ligue 1","Stade Rennais","Toulouse FC","Sébastien Tambouret","Franck Haise","Valentin Rongier","Mahdi Camara","Brice Samba","Charlie Cresswell","Adrien Thomasson","Jens Berthel Askou","Rui Borges"],"url":"https://actusport24h.fr/article/toulouse-rennes-rongier-camara-et-samba-incertains-cresswell-et-thomas/"}],"fil":[{"id":"art-stade-rennais-brice-samba-ne-fait-pas-le-voyage-a-toulouse-kilian-bela","date":"2026-11-28T16:05:00.000Z","label":"info","title":"Stade Rennais : Brice Samba ne fait pas le voyage à Toulouse, Kilian Belazzoug vers une première en Ligue 1","text":"Forfait pour la 12e journée, le gardien rennais devrait laisser sa place au jeune portier de 20 ans.","body":"Gêné par des douleurs à une hanche, **Brice Samba** ne disputera pas **Toulouse - Rennes**, dimanche (17h15), lors de la 12e journée de **Ligue 1**, et ne fait pas le déplacement dans la Ville rose. Pour le remplacer, l'entraîneur intérimaire **Sébastien Tambouret** devrait faire confiance à **Kilian Belazzoug**, 20 ans, plutôt qu'à Nicolas Lemaître, selon Le Parisien. Ce serait le premier match en Ligue 1 du gardien formé au club, récemment annoncé proche d'une prolongation jusqu'en 2030.","competition":"Ligue 1","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/stade-rennais-brice-samba-ne-fait-pas-le-voyage-a-toulouse-kilian-bela/","url":"https://actusport24h.fr/fil-info/stade-rennais-brice-samba-ne-fait-pas-le-voyage-a-toulouse-kilian-bela/"},{"id":"art-stade-rennais-brice-samba-vers-un-forfait-a-toulouse-une-operation-de","date":"2026-11-28T14:57:00.000Z","label":"rumeur","title":"Stade Rennais : Brice Samba vers un forfait à Toulouse, une opération de la hanche envisagée","text":"Le gardien rennais, gêné à une hanche, pourrait manquer le déplacement de dimanche au Stadium.","body":"Nouveau coup dur pour le **Stade Rennais**. Encore gêné par des douleurs à une hanche jeudi soir lors de la défaite à **Nimègue** (3-1) en Ligue Europa, **Brice Samba** pourrait déclarer forfait pour le déplacement à **Toulouse**, dimanche (17h15), lors de la 12e journée de Ligue 1. Selon L'Équipe, une opération serait même à l'étude pour le gardien de 32 ans. Une mauvaise nouvelle de plus pour l'intérim de **Sébastien Tambouret**, lancé dans l'urgence après le départ de **Franck Haise**.","competition":"Ligue 1","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/stade-rennais-brice-samba-vers-un-forfait-a-toulouse-une-operation-de/","url":"https://actusport24h.fr/fil-info/stade-rennais-brice-samba-vers-un-forfait-a-toulouse-une-operation-de/"},{"id":"art-toulouse-rennes-rongier-camara-et-samba-incertains-cresswell-et-thomas","date":"2026-11-28T12:55:14.528Z","label":"info","title":"Toulouse - Rennes : Rongier, Camara et Samba incertains, Cresswell et Thomasson absents… le troisième intérim de Sébastien Tambouret commence dans le flou","text":"Au lendemain de la mise à pied de Franck Haise, l'entraîneur de la réserve rennaise s'est présenté en conférence de presse ce samedi. À la veille du déplacement à Toulouse (dimanche, 17h15), il attend encore de connaître son groupe.","body":null,"competition":"Ligue 1","articleSlug":"toulouse-rennes-rongier-camara-et-samba-incertains-cresswell-et-thomas","pageUrl":"https://actusport24h.fr/fil-info/toulouse-rennes-rongier-camara-et-samba-incertains-cresswell-et-thomas/","url":"https://actusport24h.fr/article/toulouse-rennes-rongier-camara-et-samba-incertains-cresswell-et-thomas/"}]}