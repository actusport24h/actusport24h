ted":true,"played":true,"in":null,"out":null,"pos":"Milieu offensif","g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401861112","date":"2026-10-03T16:00Z","comp":"uefa.nations","team":"470","home":true,"opp":{"id":"462","name":"Bulgarie","short":"Bulgarie","logo":"https://a.espncdn.com/i/teamlogos/countries/500/bul.png"},"my":"3","op":"0","started":false,"played":true,"in":"45","out":null,"pos":null,"g":0,"a":0,"yc":0,"rc":0,"og":0},{"mid":"401861086","date":"2026-09-29T18:45Z","comp":"uefa.nations","team":"470","home":false,"opp":{"id":"582","name":"Luxembourg","short":"Luxembourg","logo":"https://a.espncdn.com/i/teamlogos/countries/500/lux.png"},"my":"3","op":"0","started":true,"played":true,"in":null,"out":"75","pos":"Attaquant axial droit","g":1,"a":1,"yc":0,"rc":0,"og":0},{"mid":"401861058","date":"2026-09-26T16:00Z","comp":"uefa.nations","team":"470","home":true,"opp":{"id":"444","name":"Estonie","short":"Estonie","logo":"https://a.espncdn.com/i/teamlogos/countries/500/est.png"},"my":"1","op":"1","started":true,"played":true,"in":null,"out":"85","pos":"Attaquant axial droit","g":1,"a":0,"yc":0,"rc":0,"og":0}],"inj":null,"articles":[],"fil":[{"id":"art-ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai","date":"2026-11-16T18:56:12.167Z","label":"info","title":"Ligue des nations : l'Islande corrige le Luxembourg (3-0) et termine invaincue en tête de son groupe","text":"À Reykjavik, Brynjólfur Willumsson, Andri Gudjohnsen sur penalty et Mikael Ellertsson ont offert aux Islandais un quatrième succès dans le groupe 4 de la Ligue C. L'Estonie a battu la Bulgarie (2-1).","body":"L'**Islande** a conclu sa phase de groupes en patron. Au Laugardalsvöllur de **Reykjavik**, les Islandais ont dominé le **Luxembourg** (**3-0**) lors de la dernière journée du groupe 4 de la **Ligue C**.\n\n**Brynjólfur Willumsson** a ouvert le score de la tête (25e), avant qu'**Andri Gudjohnsen** ne transforme un penalty (37e). **Mikael Ellertsson** a scellé le succès peu après la pause (50e).\n\nAvec **14 points** (4 victoires, 2 nuls), l'Islande termine première et invaincue. Dans l'autre match du groupe, l'**Estonie** s'est imposée face à la **Bulgarie** (**2-1**) à Tallinn grâce à **Patrik Kristal** (8e) et **Kevor Palumets** (60e, de la tête), malgré l'égalisation de **Svetoslav Kovachev** juste avant la pause (45e+1) et l'expulsion de Karel Mustmaa dans le temps additionnel. Les Estoniens, eux aussi sans défaite, finissent deuxièmes avec 12 points, devant la Bulgarie (4) et le Luxembourg (3).","competition":"Ligue des nations","articleSlug":null,"pageUrl":"https://actusport24h.fr/fil-info/ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai/","url":"https://actusport24h.fr/fil-info/ligue-des-nations-l-islande-corrige-le-luxembourg-3-0-et-termine-invai/"}]}